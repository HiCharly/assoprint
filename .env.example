APP_NAME=AssoPrint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite : un simple fichier, aucun service de base de données à faire tourner
# dans le conteneur LXC. Chemin par défaut : database/database.sqlite
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Mettre à true en production : le cookie de session n'est alors émis qu'en HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Les impressions sont envoyées à CUPS par un worker de queue (systemd),
# jamais pendant la requête HTTP.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Aucun SMTP : l'application n'envoie aucun email (pas de reset par email,
# voir docs/security.md). Tout message éventuel part dans les logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="assoprint@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Compte administrateur créé par `php artisan migrate --seed`.
# Le mot de passe ne vaut que pour la première connexion : l'application en
# impose aussitôt un autre.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# --- Impression -------------------------------------------------------------
# Nom exact de la file CUPS, tel que retourné par `lpstat -p -d`.
# Ne jamais coder ce nom en dur : il est lu via config('print.printer_name').
PRINTER_NAME=
# Adresse IPP de cette même file, interrogée avant chaque envoi pour savoir si
# l'imprimante peut imprimer. À laisser vide : elle est alors déduite du nom
# ci-dessus sur le CUPS local, ce qui est le cas de figure normal.
PRINTER_URI=
# Nombre de copies maximum accepté par tâche (garde-fou anti-abus)
PRINT_MAX_COPIES=100
# Taille maximale du PDF déposé, en kilo-octets (51200 = 50 Mo)
PRINT_MAX_FILE_SIZE_KB=51200
# Une tâche déposée alors que l'imprimante est bloquée attend : l'état est
# réinterrogé toutes les WAIT_INTERVAL secondes, et la tâche bascule en erreur
# au bout de WAIT_TIMEOUT.
PRINT_WAIT_INTERVAL_SECONDS=30
PRINT_WAIT_TIMEOUT_SECONDS=3600
